{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/groue/GRDB.swift",
      "version": {
        "version": "7.12.0",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "Sidewatch", "target-membership": [ "Sidewatch" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Sidewatch", "SidewatchMonitor", "SidewatchTests" ] },
    {
      "kind": "folder",
      "path": "SidewatchMonitor",
      "target-membership": [
        "SidewatchMonitor",
        "SidewatchTests",
      ],
      "membership-exceptions": [
        {
          "target": "SidewatchTests",
          "exclusions": [
            "Info.plist",
            "MonitorMain.swift",
          ],
        }, {
          "target": "SidewatchMonitor",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Sidewatch/Services", "target-membership": [ "SidewatchTests" ] },
    { "kind": "folder", "path": "Sidewatch/ViewModels", "target-membership": [ "SidewatchTests" ] },
    { "path": "Sidewatch/Services/ProcessSnapshotService.swift", "target-membership": [ "SidewatchMonitor/compile-sources" ] },
    { "kind": "folder", "path": "SidewatchTests", "target-membership": [ "SidewatchTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Sidewatch.app", "id": "D0FE1F2230A845B40034C4A2", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SidewatchTests.xctest", "id": "D0FE1F2230A845B40034C4B2", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/dev.shisheng.Sidewatch.Monitor.systemextension", "id": "D0FE1F2230A845B40034C4C2", "type": "wrapper.system-extension", "index": false, "target-membership": [ { "build-phase": "Sidewatch/copy/Embed System Extensions", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Sidewatch",
      "id": "D0FE1F2130A845B40034C4A2",
      "product": "Products/Sidewatch.app",
      "product-type": "application",
      "dependencies": [
        "SidewatchMonitor",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed System Extensions",
          "bundle-base-path": "contents-directory",
          "relative-path": "Library/SystemExtensions",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Sidewatch/Sidewatch.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "YOURTEAMID",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "INFOPLIST_KEY_NSSystemExtensionUsageDescription": "Sidewatch records agent process and file activity and applies the protection rules you enable.",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-lbsm",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.shisheng.Sidewatch",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OBJC_BRIDGING_HEADER": "Shared/SidewatchBridge.h",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "SidewatchTests",
      "id": "D0FE1F2130A845B40034C4B2",
      "product": "Products/SidewatchTests.xctest",
      "product-type": "bundle.unit-test",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "GRDB",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "YOURTEAMID",
        "GENERATE_INFOPLIST_FILE": "YES",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-lbsm",
          "-lEndpointSecurity",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.shisheng.Sidewatch.Tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_OBJC_BRIDGING_HEADER": "Shared/SidewatchBridge.h",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "SidewatchMonitor",
      "id": "D0FE1F2130A845B40034C4C2",
      "product": "Products/dev.shisheng.Sidewatch.Monitor.systemextension",
      "product-type": "system-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "GRDB",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "SidewatchMonitor/SidewatchMonitor.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "YOURTEAMID",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "SidewatchMonitor/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-lbsm",
          "-lEndpointSecurity",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.shisheng.Sidewatch.Monitor",
        "PRODUCT_MODULE_NAME": "SidewatchMonitor",
        "PRODUCT_NAME": "$(PRODUCT_BUNDLE_IDENTIFIER)",
        "SKIP_INSTALL": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_OBJC_BRIDGING_HEADER": "Shared/SidewatchBridge.h",
        "SWIFT_VERSION": "6.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "YOURTEAMID",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "27.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
